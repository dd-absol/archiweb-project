---
import NavigationButton from '../components/NavigationButton.astro';

interface Props {
  isLoggedIn?: boolean;
}

const { isLoggedIn } = Astro.props;

if (isLoggedIn == null) {
  console.log("this props was not passed");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Gourmet</title>
  </head>
  <body>
    <nav>
      <NavigationButton page="/" text="Home"/>
      <NavigationButton page="/login" text="Log in"/>
      <NavigationButton page="/favorites" text="Favorites"/>
    </nav>
    <h1>Gourmet in Astro!</h1>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
