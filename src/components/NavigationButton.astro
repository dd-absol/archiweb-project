---
interface Props {
  page: string;
  text: string;
}

const { page, text } = Astro.props;
---

<div
  class="inline-flex items-center px-3 py-2 border-b-2 border-transparent text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
>
  <a href={page}>
    <button>{text}</button>
  </a>
</div>
