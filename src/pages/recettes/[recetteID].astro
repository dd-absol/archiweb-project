---
// we are doing true dynamic routing here so we do not want to prerender pages at build time
export const prerender = false;

import RecipePreview from "../../components/RecipePreview.astro";
import Layout from "../../layouts/Layout.astro";
import type { RecipeData } from "../../types/RecipeData";

const { recetteID } = Astro.params;
const url = `https://gourmet.cours.quimerch.com/recipes/${recetteID}`;

const response = await fetch(url, {
  headers: {
    Accept: "application/json",
  },
});

const data: RecipeData = await response.json();
---

<Layout>
  <RecipePreview data={data}/>
  <div>
    <p>{data.instructions}</p>
  </div>
  <button>
    Add to favorites
  </button>
</Layout>

