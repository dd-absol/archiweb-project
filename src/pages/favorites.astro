---
export const prerender = false;

import RecipePreview from "../components/RecipePreview.astro";
import Layout from "../layouts/Layout.astro";

const url = "https://gourmet.cours.quimerch.com/favorites";
let data = [];
let isLoggedIn = true;

if (Astro.cookies.has("token")) {
  const cookie = Astro.cookies.get("token")?.value;

  const response = await fetch(url, {
    headers: {
      Accept: "application/json",
      Cookie: `jwt_token=${cookie}`,
    },
  });

  if (response.status != 200) {
    isLoggedIn = false;
  } else {
    data = await response.json();
  }
} else {
  isLoggedIn = false;
}
---

<Layout>
  {
    isLoggedIn ? (
      data == null ? (
        <p>No favorites added as of yet!</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {data.map((recipe: any) => (
            <RecipePreview data={recipe.recipe} />
          ))}
        </div>
      )
    ) : (
      <p>Please log in to see your favorites!</p>
    )
  }
</Layout>
