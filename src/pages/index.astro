---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import RecipePreview from "../components/RecipePreview.astro";
import type { RecipeData } from "../types/RecipeData.ts";

const recipes_url = "https://gourmet.cours.quimerch.com/recipes";
const response = await fetch(recipes_url, {
  headers: {
    Accept: "application/json",
  },
});

const responseData: RecipeData[] = await response.json();
---

<Layout>
  {responseData.map((recipe) => <RecipePreview data={recipe} />)}
</Layout>
